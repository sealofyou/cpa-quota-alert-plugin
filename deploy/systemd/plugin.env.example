# Copy to an ignored, root-only file such as:
# /etc/cpa-quota-alert-plugin/plugin.env
# Set owner root:root and mode 0600. Never commit the copied file to Git.
#
# This file is for the CPA service drop-in EnvironmentFile, not for the
# oneshot curl timer. After changing notification values, perform a controlled
# restart of the CPA service so the plugin process receives the new env.

CPA_QUOTA_ALERT_SMTP_USER=alerts@example.com
CPA_QUOTA_ALERT_SMTP_PASSWORD=x
CPA_QUOTA_ALERT_SMTP_TO=alerts@example.com
CPA_QUOTA_ALERT_SMTP_FROM=alerts@example.com

# Optional webhook channel. Leave the plugin YAML webhook.enabled=false until
# the receiving endpoint is ready.
CPA_QUOTA_ALERT_WEBHOOK_URL=https://hooks.example.com/cpa-quota-alert
CPA_QUOTA_ALERT_WEBHOOK_AUTH="Bearer example-token"
